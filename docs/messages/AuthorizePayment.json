{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://seatrush.dev/messages/AuthorizePayment.json",
  "title" : "AuthorizePayment",
  "description" : "The AuthorizePayment message of README section 10.3 as it appears on a topic, envelope and payload.",
  "type" : "object",
  "properties" : {
    "messageId" : {
      "type" : "string",
      "format" : "uuid"
    },
    "type" : {
      "const" : "AuthorizePayment"
    },
    "schemaVersion" : {
      "type" : "integer",
      "minimum" : 1
    },
    "occurredAt" : {
      "type" : "string",
      "format" : "date-time"
    },
    "correlationId" : {
      "type" : "string",
      "format" : "uuid"
    },
    "causationId" : {
      "type" : [ "string", "null" ],
      "format" : "uuid"
    },
    "traceparent" : {
      "type" : [ "string", "null" ]
    },
    "payload" : {
      "type" : "object",
      "properties" : {
        "orderId" : {
          "type" : "string",
          "format" : "uuid"
        },
        "userId" : {
          "type" : "string",
          "format" : "uuid"
        },
        "amount" : {
          "type" : "object",
          "properties" : {
            "amountCents" : {
              "type" : "integer"
            },
            "currency" : {
              "type" : "string",
              "minLength" : 3,
              "maxLength" : 3
            }
          },
          "required" : [ "amountCents", "currency" ]
        }
      },
      "required" : [ "orderId", "userId", "amount" ]
    }
  },
  "required" : [ "messageId", "type", "schemaVersion", "occurredAt", "correlationId", "payload" ]
}
