{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://seatrush.dev/messages/OrderFailed.json",
  "title" : "OrderFailed",
  "description" : "The OrderFailed message of README section 10.3 as it appears on a topic, envelope and payload.",
  "type" : "object",
  "properties" : {
    "messageId" : {
      "type" : "string",
      "format" : "uuid"
    },
    "type" : {
      "const" : "OrderFailed"
    },
    "schemaVersion" : {
      "type" : "integer",
      "minimum" : 1
    },
    "occurredAt" : {
      "type" : "string",
      "format" : "date-time"
    },
    "correlationId" : {
      "type" : "string",
      "format" : "uuid"
    },
    "causationId" : {
      "type" : [ "string", "null" ],
      "format" : "uuid"
    },
    "traceparent" : {
      "type" : [ "string", "null" ]
    },
    "payload" : {
      "type" : "object",
      "properties" : {
        "orderId" : {
          "type" : "string",
          "format" : "uuid"
        },
        "userId" : {
          "type" : "string",
          "format" : "uuid"
        },
        "eventId" : {
          "type" : "string",
          "format" : "uuid"
        },
        "failureReason" : {
          "type" : "string",
          "enum" : [ "PAYMENT_DECLINED", "SEATS_UNAVAILABLE", "TIMEOUT" ]
        }
      },
      "required" : [ "orderId", "userId", "eventId", "failureReason" ]
    }
  },
  "required" : [ "messageId", "type", "schemaVersion", "occurredAt", "correlationId", "payload" ]
}
