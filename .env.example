# Local environment for SeatRush. Copy to .env and adjust; .env is git-ignored.
# Read by the Docker Compose stack of deploy/docker-compose, which make up starts.
# Nothing here is a production credential.

# Profile every service starts with: local, bench or k8s (README section 22).
SPRING_PROFILES_ACTIVE=local

# PostgreSQL 17, one database per owning service (README section 11).
POSTGRES_PORT=5432
POSTGRES_USER=seatrush
POSTGRES_PASSWORD=seatrush
POSTGRES_INVENTORY_DB=seatrush_inventory
POSTGRES_ORDER_DB=seatrush_order
POSTGRES_PAYMENT_DB=seatrush_payment

# Redis 7.4, hot state with Lua scripting and Streams (README section 9.2).
REDIS_PORT=6379

# Kafka in KRaft mode, the single broker of the local stack (README section 10).
# The port is the one a client on the host uses; inside the stack the broker is
# reached as kafka:9092 regardless of this value.
KAFKA_PORT=9092

# The Ed25519 pair order-service signs tickets with (README section 13), base64 of a
# PKCS#8 private key and of the matching X.509 public key. Left empty on purpose: with
# nothing set the service generates a throwaway pair at startup and logs the public half,
# which is enough to try a checkout and useless for anything else. Generate a real pair
# with:
#   openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
#   openssl pkey -inform DER -pubout -outform DER <key.der | base64 -w0
# In Kubernetes these come from a Secret and are never committed.
SEATRUSH_TICKETS_PRIVATE_KEY=
SEATRUSH_TICKETS_PUBLIC_KEY=

# The two HS256 secrets of README section 13, base64 of at least 32 bytes. The first signs
# user JWTs and only the gateway holds it; the second signs admission tokens and is shared by
# queue-service and the gateway. They are two values and not one on purpose: a queue made to
# sign whatever it liked still could not mint an identity. Left empty here, which makes each
# service generate one at startup and warn that it has: that is fine for a single process and
# wrong the moment there are two, because each would refuse what the other signed. Generate
# real ones with:
#   openssl rand -base64 32
# In Kubernetes these come from a Secret and are never committed.
SEATRUSH_AUTH_SECRET=
SEATRUSH_ADMISSION_SECRET=

# How closely the waiting room follows the catalog (README sections 6.2 and 22). Inventory
# moves an event to ON_SALE and queue-service shuffles its lobby into the queue within one
# refresh, so this value is also how late a sale can open.
SEATRUSH_QUEUE_CATALOG_REFRESH_INTERVAL=1s
SEATRUSH_QUEUE_LOBBY_OPEN_INTERVAL=1s

# The door of a sale (README sections 6.2 and 22). max-active-users is the number that makes a
# flash on-sale bounded: however long the queue is, inventory never sees more buyers holding
# seats than this. Both are per pod, because the admission job runs on every pod with no
# leader. Lower them to watch a queue move in a demo.
SEATRUSH_ADMISSION_RATE_PER_SECOND=500
SEATRUSH_ADMISSION_MAX_ACTIVE_USERS=5000
SEATRUSH_ADMISSION_TOKEN_TTL=10m

# The pushed stream of the waiting room (README sections 6.2 and 22). The first is how often
# every listening client is looked at, the second how long a quiet connection may hear nothing
# before a keep-alive comment, and the third how long one stream may stay open before the client
# is asked to reconnect, which is what bounds the connections a pod holds.
SEATRUSH_QUEUE_POSITION_UPDATE_INTERVAL=3s
SEATRUSH_SSE_HEARTBEAT_INTERVAL=15s
SEATRUSH_SSE_TIMEOUT=30m

# How long seat changes accumulate before they are pushed as one delta (README sections 6.6
# and 22). The same two knobs above also govern the seat map stream: one answer for how this
# system treats an idle stream, whatever it is streaming. Lower this to watch a venue fill
# more closely, at one message per client per window.
SEATRUSH_REALTIME_BATCH_WINDOW=200ms

# Where the gateway finds the services behind it (README sections 6.1 and 22). On Kubernetes
# these are service names and the cluster resolves them; locally they are the ports below.
SEATRUSH_GATEWAY_INVENTORY_URL=http://localhost:8081
SEATRUSH_GATEWAY_ORDER_URL=http://localhost:8082
SEATRUSH_GATEWAY_QUEUE_URL=http://localhost:8084
SEATRUSH_GATEWAY_REALTIME_URL=http://localhost:8085

# Published ports of the local endpoints (README section 23).
GATEWAY_PORT=8080
UI_PORT=5173
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=3200

# Where every service sends its spans (README section 14.2). The port Tempo publishes to the
# host, because the services run outside the stack network; a service started inside it uses
# http://tempo:4318/v1/traces instead.
OTLP_PORT=4318
SEATRUSH_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# The share of requests that are traced, read by the gateway: a trace is born at the
# door and nowhere else, so this is the one number that decides how many there are. One
# locally, so a demo keeps every trace; a benchmark of 50k arrivals a second is the case
# this exists to turn down.
SEATRUSH_TRACING_SAMPLE_RATE=1.0

# The share of background work that starts a trace of its own, read by the other five
# services. Zero, because the relays tick ten times a second and almost always find
# nothing: raise it on one service to look at its schedulers (README section 14.2).
SEATRUSH_TRACING_BACKGROUND_SAMPLE_RATE=0.0

# Grafana opens read-only without a login; these credentials are only needed to
# edit anything by hand (README section 14.4).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
