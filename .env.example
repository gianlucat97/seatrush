# Local environment for SeatRush. Copy to .env and adjust; .env is git-ignored.
# Read by the Docker Compose stack of deploy/docker-compose, which the next
# feature of M1 introduces. Nothing here is a production credential.

# Profile every service starts with: local, bench or k8s (README section 22).
SPRING_PROFILES_ACTIVE=local

# PostgreSQL 17, one database per owning service (README section 11).
POSTGRES_PORT=5432
POSTGRES_USER=seatrush
POSTGRES_PASSWORD=seatrush
POSTGRES_INVENTORY_DB=seatrush_inventory
POSTGRES_ORDER_DB=seatrush_order
POSTGRES_PAYMENT_DB=seatrush_payment

# Redis 7.4, hot state with Lua scripting and Streams (README section 9.2).
REDIS_PORT=6379

# Kafka in KRaft mode, the single broker of the local stack (README section 10).
KAFKA_PORT=9092

# Published ports of the local endpoints (README section 23).
GATEWAY_PORT=8080
UI_PORT=5173
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
