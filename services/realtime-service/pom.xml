<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.seatrush</groupId>
    <artifactId>seatrush-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>seatrush-realtime-service</artifactId>

  <name>SeatRush Realtime Service</name>
  <description>The seat map delta stream: every seat change of a sale, batched and pushed to the clients watching it</description>

  <dependencies>
    <!-- The clock every batch is timed against and the id generator the per pod consumer
         group is named from. -->
    <dependency>
      <groupId>com.seatrush</groupId>
      <artifactId>seatrush-common</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The envelope of inventory.seat-events, the router that dispatches one and the
         consumer error policy its listener runs under. Nothing of the outbox is used here:
         this service publishes no message, because it changes nothing anybody else reads. -->
    <dependency>
      <groupId>com.seatrush</groupId>
      <artifactId>seatrush-messaging</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The listener on inventory.seat-events, and the producer the dead letter topic is
         written with. spring-kafka is optional inside libs/messaging, so a service that
         consumes asks for it here. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- No Redis, no database and no secret: this service holds nothing but its open
         connections, which is what lets a pod of it die without losing anything (README
         section 16). -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- MockMvc and the @WebMvcTest slice, which Boot 4 ships next to the web starter
         rather than inside spring-boot-starter-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The shared Kafka broker and the movable clock of the integration tests. -->
    <dependency>
      <groupId>com.seatrush</groupId>
      <artifactId>seatrush-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The layering rules of README section 17. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
