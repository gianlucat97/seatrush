<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.seatrush</groupId>
    <artifactId>seatrush-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>seatrush-gateway</artifactId>

  <name>SeatRush Gateway</name>
  <description>The single entry point: user tokens, admission on purchase commands, and the routes behind it</description>

  <dependencies>
    <!-- The error codes and the Problem Details factory every service answers with. -->
    <dependency>
      <groupId>com.seatrush</groupId>
      <artifactId>seatrush-common</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Both tokens of README section 13: this is the only place that reads the user one, and
         the only place besides queue-service that holds the admission secret. -->
    <dependency>
      <groupId>com.seatrush</groupId>
      <artifactId>seatrush-security</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Reactive, and for one reason: this process holds every SSE connection of every waiting
         client, and a thread per connection is the limit README section 15 refuses to have. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- WebTestClient and the auto-configuration that binds one to the running server, which
         is how a filter of this service is asserted: through a request that crossed a socket.
         Boot 4 ships it next to the web starter rather than inside spring-boot-starter-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webtestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The movable clock, so an expired token is a test and not a wait. -->
    <dependency>
      <groupId>com.seatrush</groupId>
      <artifactId>seatrush-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The layering rules of README section 17. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
