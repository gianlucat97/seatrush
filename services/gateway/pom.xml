<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.seatrush</groupId>
    <artifactId>seatrush-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>seatrush-gateway</artifactId>

  <name>SeatRush Gateway</name>
  <description>The single entry point: user tokens, admission on purchase commands, and the routes behind it</description>

  <dependencies>
    <!-- The error codes and the Problem Details factory every service answers with. -->
    <dependency>
      <groupId>com.seatrush</groupId>
      <artifactId>seatrush-common</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Both tokens of README section 13: this is the only place that reads the user one, and
         the only place besides queue-service that holds the admission secret. -->
    <dependency>
      <groupId>com.seatrush</groupId>
      <artifactId>seatrush-security</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Reactive, and for one reason: this process holds every SSE connection of every waiting
         client, and a thread per connection is the limit README section 15 refuses to have. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- The token buckets of README section 13, which are the one piece of state this service
         has and deliberately does not keep: a limit of ten per pod across six pods is a limit
         of sixty, and the autoscaler of section 24.3 changes that number under load. Reactive,
         because a blocking round trip here would be on the event loop holding every SSE
         connection of every waiting client. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- The OpenAPI document of this service, served at /v3/api-docs and published under
         docs/api/ (README section 12). The WebFlux starter, because this process is reactive, and
         it describes the one endpoint this service answers itself: the routes it proxies belong to
         the services behind it and are documented by theirs. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webflux-api</artifactId>
    </dependency>
    <!-- The Prometheus registry and the shared meter configuration (README section 14.1).
         Without it the domain meters of this service exist only inside its own process:
         this is what puts them on /actuator/prometheus, with the histogram buckets the p99
         panels read and the service tag that says which of the six they came from. -->
    <dependency>
      <groupId>com.seatrush</groupId>
      <artifactId>seatrush-observability</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- One trace across every service of a checkout (README section 14.2). The starter is the
         whole of it: the auto-configuration that builds a Tracer and a Propagator, the bridge
         that makes them OpenTelemetry, and the OTLP exporter that ships finished spans to the
         collector. Those two beans are also what seatrush-messaging carries a trace across the
         outbox with; without this starter it finds neither and stamps nothing. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- WebTestClient and the auto-configuration that binds one to the running server, which
         is how a filter of this service is asserted: through a request that crossed a socket.
         Boot 4 ships it next to the web starter rather than inside spring-boot-starter-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webtestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The movable clock, so an expired token is a test and not a wait, and the Redis
         container the token buckets are asserted against: a limit is arithmetic over a clock
         and a store, and a fake of either would be a test of the fake. -->
    <dependency>
      <groupId>com.seatrush</groupId>
      <artifactId>seatrush-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The layering rules of README section 17. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
