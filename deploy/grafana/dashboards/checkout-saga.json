    {
      "type": "timeseries",
      "title": "Payment replays per second",
      "description": "A command answered from the stored result of an identical one rather than sent to the provider again. This is what makes a redelivered AuthorizePayment safe, and the number that would otherwise be a double charge.",
      "datasource": {
        "type": "prometheus",
