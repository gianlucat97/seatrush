    {
      "type": "timeseries",
      "title": "Checkout duration percentiles",
      "description": "End to end, from the command to the terminal state, across five services and a simulated payment whose own median is 300 ms. The dashed line is the p99 target of README section 15 and is an exact bucket edge in the exported metric.",
      "datasource": {
        "type": "prometheus",
        "uid": "seatrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(seatrush_saga_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "editorMode": "code",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(seatrush_saga_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "editorMode": "code",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(seatrush_saga_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "editorMode": "code",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
