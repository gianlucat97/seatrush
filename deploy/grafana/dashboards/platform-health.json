    {
      "type": "timeseries",
      "title": "Dead letters retained by topic",
      "description": "What a dead letter topic still holds: the current offset less the oldest one, rather than the current offset alone, because offsets never go back. Nothing consumes these topics, so anything above zero is a message this system gave up on and a person has to look at.",
      "datasource": {
        "type": "prometheus",
        "uid": "seatrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "sum by (topic) (\n  kafka_topic_partition_current_offset{topic=~\".+\\\\.dlq\"}\n  - kafka_topic_partition_oldest_offset{topic=~\".+\\\\.dlq\"}\n)",
          "range": true,
          "editorMode": "code",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
