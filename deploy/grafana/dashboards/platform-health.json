    {
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "description": "Records written to a topic and not yet read, from the Kafka exporter, because a consumer knows the offset it has reached and not the offset the log is at. The realtime groups are collapsed into one series: that service uses a group per pod on purpose, since every pod needs every seat event (README section 6.6).",
      "datasource": {
        "type": "prometheus",
        "uid": "seatrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "sum by (consumergroup, topic) (\n  label_replace(kafka_consumergroup_lag,\n    \"consumergroup\", \"realtime\", \"consumergroup\", \"realtime-.*\")\n)",
          "range": true,
          "editorMode": "code",
          "legendFormat": "{{consumergroup}} / {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
