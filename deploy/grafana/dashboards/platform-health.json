    {
      "type": "timeseries",
      "title": "Outbox lag by store",
      "description": "The age of the oldest message written and not yet published, for both outboxes of README section 9.5: the table in Postgres and the stream in Redis. Both publish under one metric name, which is what lets one alert rule cover them. The dashed line is the 5 s of section 14.4.",
      "datasource": {
        "type": "prometheus",
        "uid": "seatrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "max by (store) (seatrush_outbox_lag_seconds)",
          "range": true,
          "editorMode": "code",
          "legendFormat": "{{store}}"
