    {
      "type": "timeseries",
      "title": "API p99 by service",
      "description": "Per service rather than per endpoint, which is the altitude of this dashboard. The per-endpoint targets of README section 15 are read by selecting a uri on the service that serves it, and never on the gateway, whose own timer tags a proxied route uri=UNKNOWN.",
      "datasource": {
        "type": "prometheus",
        "uid": "seatrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_server_requests_seconds_bucket[$__rate_interval])))",
          "range": true,
          "editorMode": "code",
          "legendFormat": "{{service}}"
