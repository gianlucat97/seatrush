    {
      "type": "stat",
      "title": "Oversold seats",
      "description": "Sales the Postgres guard refused over the selected range. Specified to stay at zero (README section 4): anything else means two orders reached the commit for the same seat, so nothing was oversold and the hold path has a bug.",
      "datasource": {
        "type": "prometheus",
        "uid": "seatrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "sum(increase(seatrush_oversell_prevented_total[$__range])) or vector(0)",
          "range": true,
          "editorMode": "code",
          "legendFormat": "prevented"
        }
