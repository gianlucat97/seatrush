    {
      "type": "timeseries",
      "title": "Hold latency",
      "description": "One Lua call against Redis, which is the busiest operation of an on-sale. The dashed line is the p99 target of README section 15, and it is a bucket edge in the exported metric rather than an interpolation towards one.",
      "datasource": {
        "type": "prometheus",
        "uid": "seatrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(seatrush_hold_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "editorMode": "code",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(seatrush_hold_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "editorMode": "code",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
