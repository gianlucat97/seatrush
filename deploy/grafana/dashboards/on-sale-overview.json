    {
      "type": "timeseries",
      "title": "Waiting room by state",
      "description": "The lobby and the queue apart rather than as one total. They are the two halves of the only transition a waiting room has: inventory moves the event to ON_SALE and the lobby empties into the queue in one shuffle, and a sum of them would be flat across exactly that instant.",
      "datasource": {
        "type": "prometheus",
        "uid": "seatrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "seatrush-prometheus"
          },
          "expr": "max by (event, state) (seatrush_queue_length)",
          "range": true,
          "editorMode": "code",
          "legendFormat": "{{state}} ({{event}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
